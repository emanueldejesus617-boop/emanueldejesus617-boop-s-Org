# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Email Delivery Integration for POST /api/contact
# Configure either Resend or Formspree to enable direct server-side email delivery:
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL=""
# FORMSPREE_ENDPOINT=""
